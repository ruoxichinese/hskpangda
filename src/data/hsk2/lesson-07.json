      "lines": [
        {
          "speaker": "chentianzhong",
          "zh": "安妮，你是什么时候从北京回来的？",
          "vi": "Annie, cậu từ Bắc Kinh về lúc nào thế?",
          "t": 0.46
        },
        {
          "speaker": "anni",
          "zh": "昨天下午。天中，你怎么一下课就往外跑？",
          "vi": "Chiều hôm qua. Thiên Trung, sao cậu vừa tan học là chạy ra ngoài thế?",
          "t": 5.81
        },
        {
          "speaker": "chentianzhong",
          "zh": "我跟同学说好了，一起去打篮球。",
          "vi": "Mình hẹn với bạn rồi, cùng đi chơi bóng rổ.",
          "t": 12.62
        },
        {
          "speaker": "anni",
          "zh": "我也想跟你们一起玩。",
          "vi": "Mình cũng muốn chơi cùng các cậu.",
          "t": 17.93
        },
        {
          "speaker": "chentianzhong",
          "zh": "没问题，走吧。",
          "vi": "Được thôi, đi nào.",
          "t": 20.98
        }
      ],
      "vocab": [
